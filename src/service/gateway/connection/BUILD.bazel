load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "connection",
    srcs = [
        "connection_service.go",
        "connection_service_printer.go",
    ],
    importpath = "github.com/cubbit/composer-cli/src/service/gateway/connection",
    visibility = ["//visibility:public"],
    deps = [
        "//constants",
        "//src/api",
        "//src/configuration/configuration_handler",
        "//src/configuration/configuration_models",
        "//utils/printer",
        "//utils/printer/table",
        "@com_github_google_uuid//:uuid",
        "@com_github_spf13_cobra//:cobra",
    ],
)

go_test(
    name = "connection_test",
    srcs = ["connection_service_test.go"],
    embed = [":connection"],
    deps = [
        "//src/api",
        "//src/configuration/configuration_models",
        "@com_github_spf13_cobra//:cobra",
    ],
)
