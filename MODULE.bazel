module(name = "composer_cli")

bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "rules_go", version = "0.65.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.6")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "com_github_burntsushi_toml", "com_github_charmbracelet_bubbles", "com_github_charmbracelet_bubbletea", "com_github_charmbracelet_lipgloss", "com_github_creack_pty", "com_github_google_uuid", "com_github_mattn_go_runewidth", "com_github_muesli_reflow", "com_github_pkg_browser", "com_github_sahilm_fuzzy", "com_github_spf13_cobra", "com_github_spf13_pflag", "in_gopkg_yaml_v3")
